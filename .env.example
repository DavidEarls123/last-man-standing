# Copy to .env and edit. Everything here has a working default except
# SESSION_SECRET, which is required in production.

NODE_ENV=development
PORT=3000
PUBLIC_URL=http://localhost:3000

# Signs session cookies. Generate with: openssl rand -hex 48
SESSION_SECRET=
SESSION_TTL_DAYS=14
DATABASE_FILE=./data/lms.sqlite
BCRYPT_ROUNDS=12

# --- Football data ---------------------------------------------------------
# local        : fixtures and results live in this database (super admin enters
#                results, or SIMULATE_LIVE generates them)
# football-data: live Premier League data from https://football-data.org
FOOTBALL_PROVIDER=local
FOOTBALL_DATA_API_KEY=
FOOTBALL_DATA_COMPETITION=PL
FOOTBALL_POLL_SECONDS=60
# Between matches, ask upstream this rarely instead. Keeps a free — or shared —
# API key well under its rate limit.
FOOTBALL_IDLE_POLL_SECONDS=900

# Where people reach this app. Invite links are built from it, so while it says
# localhost an invite means "their own computer" to whoever clicks it.
# `npm run share` sets this for you; set it by hand for a real server.
# PUBLIC_URL=https://lastonestanding.example.com
# Drive fake live scores from the sample fixtures — handy for demos.
SIMULATE_LIVE=false

# --- Email -----------------------------------------------------------------
# console prints messages to the server log instead of sending them.
EMAIL_PROVIDER=console
EMAIL_FROM="Last One Standing <no-reply@example.com>"
SMTP_URL=smtps://user:pass@smtp.example.com:465

# --- SMS -------------------------------------------------------------------
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+447700900000
